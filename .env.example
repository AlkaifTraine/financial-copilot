# Copy to `.env` and fill in. `.env` is gitignored.

# Required — powers chat, report writing, and embeddings.
OPENAI_API_KEY=sk-...

# Required for SEC EDGAR access.
# The SEC mandates a descriptive User-Agent containing real contact details on
# every request. Requests without one are rejected; abusive clients are IP
# banned. Format: "App Name your.email@example.com"
SEC_USER_AGENT=Financial Copilot your.email@example.com
