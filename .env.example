# Copy to `.env` and fill in. `.env` is gitignored.

# Required — powers chat, report writing, and embeddings.
OPENAI_API_KEY=sk-...

# Required for SEC EDGAR access.
# The SEC mandates a descriptive User-Agent containing real contact details on
# every request. Requests without one are rejected; abusive clients are IP
# banned. Format: "App Name your.email@example.com"
SEC_USER_AGENT=Financial Copilot your.email@example.com

# ---- Cross-provider fallback (recommended for anything public-facing) ----
# Without this the app runs OpenAI-only: an OpenAI incident means reports fail.
# With it, the LiteLLM router crosses to Gemini automatically when every OpenAI
# deployment has failed or is cooling down. Get a key at aistudio.google.com.
GEMINI_API_KEY=

# ---- Routing (optional; sensible defaults in fincopilot/config.py) ----
# Per-deployment request ceilings the router load-balances against. Set these
# BELOW the provider's real limit so traffic shifts before you see 429s.
# OPENAI_RPM=400
# GEMINI_RPM=150
# ROUTER_STRATEGY=simple-shuffle

# ---- Query intent filter ----
# Every chat question is classified by the cheap model before retrieval, to
# judge what it is FOR. Catches rephrased injection that pattern matching
# misses. Fails open: if the classifier is down, questions still get answered.
# QUERY_CLASSIFIER_ENABLED=1
# How sure it must be to actually refuse. Low values start rejecting real
# analysts' questions, which is the expensive error.
# QUERY_BLOCK_CONFIDENCE=0.7

# ---- Cost control ----
# Hard ceiling on LLM spend for one process. Past it, calls are refused rather
# than served — a runaway retry loop is a billing incident, not just a bug.
# MAX_USD_PER_PROCESS=25

# Where generated reports are stored so they are not regenerated until the
# company files something new. Defaults to data/reports.db.
# REPORT_DB_PATH=

# ---- Access control ----
# The front door is ON by default — the safe default for a public URL in front
# of a paid API. With it on and no ACCESS_CODE set, visitors must bring their
# own key, so your credits cannot be spent by a stranger at all.
# Set to 0 ONLY for local development.
# REQUIRE_ACCESS=0
#
# Shared code you hand out to people you want using your API credits. It has NO
# default and is deliberately not in the repo: this repository is public, so a
# code committed to source is readable by anyone and authorises spending on your
# OpenAI account. Set it here on the instance only. Rotate by changing it and
# restarting. Visitors without a code can still use the app with their own key.
# ACCESS_CODE=

# ---- Usage analytics ----
# Records companies loaded, questions asked, failures and cost, to data/usage.db.
# API keys are NEVER stored. Question text is scrubbed of secrets and PII first.
# ANALYTICS_ENABLED=1
# ANALYTICS_DB_PATH=
# Set to 0 to keep only question length and category, not the text itself.
# ANALYTICS_STORE_QUESTION_TEXT=1

# ---- Public demo ----
# Enables per-session and global daily rate limits. Set to 1 when deploying.
# DEMO_MODE=1
